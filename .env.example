# ─── Database (Neon PostgreSQL recommended) ─────────────────────────────────
# Create free project at https://neon.tech → copy connection strings from Dashboard
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# Direct (non-pooled) — required for Prisma migrations
DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=your_secret_here
NEXTAUTH_URL=https://akusto.ru

# ─── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://akusto.ru
NEXT_PUBLIC_SITE_NAME=ACOUSTIC SPACE

# ─── SMS (smsc.ru) ────────────────────────────────────────────────────────────
SMSC_LOGIN=your_smsc_login
SMSC_PASSWORD=your_smsc_password

# ─── Email (SMTP via Nodemailer or Resend) ────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@akusto.ru
RESEND_TO_EMAIL=hello@akusto.ru
# Alternative SMTP settings
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_password

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── Seller / Invoicing ───────────────────────────────────────────────────────
SELLER_NAME=ООО «Acoustic Space»
SELLER_INN=7700000000
SELLER_KPP=770000000
SELLER_OGRN=1000000000000
SELLER_ADDRESS=г. Москва, ул. Примерная, д. 1
SELLER_BANK=АО «Банк»
SELLER_BIK=044000000
SELLER_ACCOUNT=40700000000000000000
SELLER_CORR_ACCOUNT=30100000000000000000

# ─── Delivery ─────────────────────────────────────────────────────────────────
DELIVERY_COURIER_FEE=50000
DELIVERY_TRANSPORT_FEE=300000

# ─── Phone & Contacts ─────────────────────────────────────────────────────────
NEXT_PUBLIC_PHONE=+79777903983
NEXT_PUBLIC_PHONE_DISPLAY=+7 977 790-39-83
NEXT_PUBLIC_EMAIL=hello@akusto.ru
NEXT_PUBLIC_TELEGRAM=https://t.me/akusto
NEXT_PUBLIC_WHATSAPP=https://wa.me/70000000000
NEXT_PUBLIC_CITY=Москва
NEXT_PUBLIC_ADDRESS=
